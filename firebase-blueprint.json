{
  "entities": {
    "employee": {
      "title": "Employee",
      "description": "An employee record in the organization",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the employee"
        },
        "role": {
          "type": "string",
          "description": "The job title or role of the employee"
        },
        "department": {
          "type": "string",
          "description": "The department of the employee"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Working email of the employee"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the employee"
        },
        "status": {
          "type": "string",
          "enum": [
            "Active",
            "Onboarding",
            "Suspended"
          ],
          "description": "Current employment or onboarding status"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Onboarding/joining date of the employee"
        },
        "createdBy": {
          "type": "string",
          "description": "The user UID who registered the employee"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was last updated"
        }
      },
      "required": [
        "name",
        "role",
        "department",
        "email",
        "phone",
        "status",
        "joinedAt",
        "createdBy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "employees/{employeeId}": {
      "schema": "employee",
      "description": "Collection of employee records"
    }
  }
}
